{
  "name": "@sting8k/pi-vcc",
  "version": "0.10.1",
  "description": "Algorithmic conversation compactor for pi - transcript-preserving structured summaries, no LLM calls",
  "license": "MIT",
  "main": "index.ts",
  "files": [
    "index.ts",
    "src/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "vcc",
    "compact",
    "compaction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sting8k/pi-vcc.git"
  },
  "scripts": {
    "typecheck": "tsc --ignoreConfig --noEmit --skipLibCheck --module preserve --moduleResolution bundler --target ES2022 --types node index.ts"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0 <2.0.0",
    "typebox": ">=1.1.24 <2.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
